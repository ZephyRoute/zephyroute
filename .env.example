# NEAR Intents 1Click API
ONECLICK_INTEGRATOR_ID=
ONECLICK_API_KEY=

# DeFindex API
DEFINDEX_API_KEY=
# The real mainnet address of the default USDC Blend Autocompound vault.
# Not verified anywhere in this project's own research (see Story 1.9,
# docs/prds/.../.decision-log.md); confirm before setting in production.
DEFINDEX_VAULT_ADDRESS=

# Upstash Redis (correlation + rate-limit cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# DFNS (Story 2.2, embedded wallet onboarding)
# Requires an actual DFNS organization and service account (external
# signup, not something this project can self-provision). Verified
# against the installed @dfns/sdk's own .d.ts, not live-tested.
DFNS_API_URL=https://api.dfns.io
DFNS_ORG_ID=
DFNS_SERVICE_ACCOUNT_AUTH_TOKEN=
DFNS_SERVICE_ACCOUNT_CRED_ID=
DFNS_SERVICE_ACCOUNT_PRIVATE_KEY=
# The relying-party id/name are the app's own domain and display name,
# not secrets, safe to inline into the client bundle.
NEXT_PUBLIC_DFNS_RELYING_PARTY_ID=
NEXT_PUBLIC_DFNS_RELYING_PARTY_NAME=Zephyroute

# Zephyroute's own treasury account that sponsors each new user's
# account and trustline reserve (Story 2.2, founder-authorized
# 2026-09-22). A real Stellar secret key, must hold real XLM before
# this can run in production. See the Story 2.2 decision log entry for
# the stronger, not-yet-built alternative (a DFNS-custodied sponsor
# wallet instead of a raw hot key).
ZEPHYROUTE_SPONSOR_SECRET_KEY=
